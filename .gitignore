# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude tfvars that may contain secrets (keep *.tfvars.example)
*.tfvars
!*.tfvars.example
*.auto.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Lock file is committed for reproducible CI
# .terraform.lock.hcl

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
